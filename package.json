{
  "name": "sam",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "description": "Sam: limpeza de disco para quem programa no macOS, explicando o que cada item é e o que acontece ao apagar.",
  "type": "module",
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "generate": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "test": "npm run test:rust && npm run test:web",
    "test:rust": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "svelte-check --tsconfig ./tsconfig.json && vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "web:dev": "vite",
    "web:build": "vite build",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-log": "~2.9.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
